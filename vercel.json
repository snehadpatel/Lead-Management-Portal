{
  "version": 2,
  "builds": [
    {
      "src": "api/main_enhanced.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(health|predict|analytics|risk/.*|dashboard/.*|model/.*|insights|alerts/.*|market/.*|monitoring/.*|funds/.*|user/.*|distributors/.*|advisor/.*|buddy/.*)",
      "dest": "api/main_enhanced.py"
    },
    {
      "src": "/frontend/(.*)",
      "dest": "frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/main_enhanced.py"
    }
  ]
}
